/// Hold reason codes of the rulebook (rules/hold_reasons.csv).
table DimReason

	column ReasonCode
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: ReasonCode

	column ReasonLabel
		dataType: string
		summarizeBy: none
		sourceColumn: ReasonLabel

	column Category
		dataType: string
		summarizeBy: none
		sourceColumn: Category

	column DetectableBeforeLodgement
		dataType: string
		summarizeBy: none
		sourceColumn: DetectableBeforeLodgement

	partition DimReason = m
		mode: import
		source =
				let
					Source = Csv.Document(
						if Text.StartsWith(DataFolder, "http") then Web.Contents(DataFolder & "dim_reason.csv") else File.Contents(DataFolder & "dim_reason.csv"),
						[Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
					),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"ReasonCode", type text}, {"ReasonLabel", type text}, {"Category", type text}, {"DetectableBeforeLodgement", type text}}, "en-US")
				in
					Typed

	annotation PBI_ResultType = Table
