/// Every day from 1 March to 30 November 2026. Marked as the date table.
table DimDate
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Year

	column MonthNumber
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: MonthNumber

	column MonthName
		dataType: string
		summarizeBy: none
		sourceColumn: MonthName
		sortByColumn: MonthNumber

	/// Calendar month as text, e.g. 2026-05.
	column YearMonth
		dataType: string
		summarizeBy: none
		sourceColumn: YearMonth

	column IsoWeekday
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: IsoWeekday

	column DayName
		dataType: string
		summarizeBy: none
		sourceColumn: DayName
		sortByColumn: IsoWeekday

	partition DimDate = m
		mode: import
		source =
				let
					Source = Csv.Document(
						if Text.StartsWith(DataFolder, "http") then Web.Contents(DataFolder & "dim_date.csv") else File.Contents(DataFolder & "dim_date.csv"),
						[Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
					),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"Date", type date}, {"Year", Int64.Type}, {"MonthNumber", Int64.Type}, {"MonthName", type text}, {"YearMonth", type text}, {"IsoWeekday", Int64.Type}, {"DayName", type text}}, "en-US")
				in
					Typed

	annotation PBI_ResultType = Table
