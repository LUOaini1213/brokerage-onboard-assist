      "measures": {
        "Enrolments at Stage": {
          "expression": "COUNTROWS(FactEnrolmentStage)",
          "formatString": "#,##0"
        },
        "Enrolments Submitted": {
          "expression": "CALCULATE([Enrolments at Stage], REMOVEFILTERS(DimStage), DimStage[StageOrder] = 1)",
          "formatString": "#,##0"
        },
        "Profiles Created": {
          "expression": "CALCULATE([Enrolments at Stage], REMOVEFILTERS(DimStage), DimStage[StageOrder] = 4)",
          "formatString": "#,##0"
        },
        "Three Shipments Completed": {
          "expression": "CALCULATE([Enrolments at Stage], REMOVEFILTERS(DimStage), DimStage[StageOrder] = 6)",
          "formatString": "#,##0"
        },
        "Stage Conversion %": {
          "expression": "DIVIDE([Enrolments at Stage], [Enrolments Submitted])",
          "formatString": "0.0%"
        },
        "Step Conversion %": {
          "expression": "VAR s = SELECTEDVALUE(DimStage[StageOrder])\nVAR prev = CALCULATE([Enrolments at Stage], REMOVEFILTERS(DimStage), DimStage[StageOrder] = s - 1)\nRETURN IF(ISBLANK(s) || s = 1, BLANK(), DIVIDE([Enrolments at Stage], prev))",
          "formatString": "0.0%"
        },
        "Median Days to Stage": {
          "expression": "MEDIAN(FactEnrolmentStage[DaysFromSubmission])",
          "formatString": "0.0"
        }
